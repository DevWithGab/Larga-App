<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android's 288dp splash viewport masks to a 192dp safe circle. -->
  <item>
    <shape android:shape="rectangle">
      <size android:width="288dp" android:height="288dp" />
      <solid android:color="@android:color/transparent" />
    </shape>
  </item>
  <item android:width="180dp" android:height="180dp" android:gravity="center">
    <shape android:shape="oval">
      <solid android:color="#FFF7ED" />
      <stroke android:width="1dp" android:color="#FED7AA" />
    </shape>
  </item>
  <item android:width="140dp" android:height="140dp" android:gravity="center">
    <bitmap android:src="@drawable/larga_splash_mark" android:gravity="fill" android:filter="true" />
  </item>
</layer-list>
