{
  "expo": {
    "name": "Larga",
    "slug": "larga-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.largaapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCircularSplash",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Larga to use your location for real-time tracking."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Larga to use your camera to scan a jeepney's QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo-larga-short.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa41a8c4-0168-4418-98ec-33e857272593"
      }
    }
  }
}
