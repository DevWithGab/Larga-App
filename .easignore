# EAS archives from this repository root; only the mobile client is needed.
/larga-web/
/branding/

# Preserve the mobile client's .gitignore rules: .easignore replaces them.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env*.local
*.tsbuildinfo

# Native projects are generated by Expo Prebuild on the build server.
# Unanchored names also match the nested mobile client on Windows.
android/
ios/
.gradle/
.cxx/

# Local assistant/editor metadata is not part of the app.
.claude/
.codex/
.agents/
